{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": ["PROJECT.md"],
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "dist/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "docs/source/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".claude/**",
      "effect": "deny"
    },
    {
      "action": "playwright_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "chrome_devtools_*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      }
    }
  },
  "agents": {
    "build": {
      "model": "opencode-go/glm-5.3"
    },
    "plan": {
      "model": "opencode-go/qwen4-max"
    },
    "architect": {
      "model": "opencode-go/kimi-k3.1-pro"
    },
    "reviewer": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "doc-writer": {
      "model": "opencode-go/gpt-5.6-luna#medium"
    },
    "fullstack": {
      "model": "opencode-go/kimi-k2.7-code"
    },
    "frontend": {
      "disabled": true,
      "model": "opencode-go/gpt-6-luna#medium"
    }
  }
}
